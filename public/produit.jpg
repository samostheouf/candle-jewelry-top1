<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <!-- Fond -->
  <rect width="800" height="800" fill="#fefcf5"/>
  <!-- Ombre porte-bougie -->
  <ellipse cx="400" cy="700" rx="120" ry="20" fill="#1c1917" opacity="0.15"/>
  <!-- Corps du porte-bougie (argent/bijou) -->
  <rect x="340" y="380" width="120" height="320" rx="8" fill="#a8a29e" stroke="#78716c" stroke-width="2"/>
  <rect x="350" y="400" width="100" height="60" fill="#d6d3d1" opacity="0.5"/>
  <!-- Bijou sur le porte-bougie -->
  <circle cx="400" cy="350" r="24" fill="#fbbf24" stroke="#d97706" stroke-width="3"/>
  <text x="400" y="357" font-family="Georgia, serif" font-style="italic" font-size="22" fill="#1c1917" text-anchor="middle">C</text>
  <!-- Bougie -->
  <rect x="376" y="200" width="48" height="180" fill="#fefcf5" stroke="#a8a29e" stroke-width="1"/>
  <rect x="380" y="200" width="8" height="180" fill="#f5f5f4" opacity="0.6"/>
  <!-- Mèche -->
  <line x1="400" y1="200" x2="400" y2="180" stroke="#1c1917" stroke-width="2"/>
  <!-- Flamme -->
  <ellipse cx="400" cy="160" rx="10" ry="22" fill="#fbbf24"/>
  <ellipse cx="400" cy="160" rx="5" ry="14" fill="#fde68a"/>
  <ellipse cx="400" cy="160" rx="2" ry="8" fill="#fffbeb"/>
  <!-- Lueur -->
  <circle cx="400" cy="160" r="120" fill="#fbbf24" opacity="0.08"/>
  <!--Détails luxe -->
  <text x="400" y="720" font-family="Georgia, serif" font-style="italic" font-size="28" fill="#1c1917" text-anchor="middle">Bougie Bijou Luxe</text>
  <text x="400" y="750" font-family="system-ui, sans-serif" font-size="18" fill="#78716c" text-anchor="middle">CANDLE</text>
</svg>